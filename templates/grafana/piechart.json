{
    "datasource": {
      "type": "marcusolsson-json-datasource",
      "uid": {{ datasource_uid | jsonify }}

    },
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "palette-classic"
        },
        "custom": {
          "hideFrom": {
            "legend": false,
            "tooltip": false,
            "viz": false
          }
        },
        "mappings": []
      },
      "overrides": []
    },
    "gridPos": {{ grid_pos | jsonify }},
    "id": {{id | jsonify }},
    "options": {
      "legend": {
        "displayMode": "list",
        "placement": "bottom",
        "showLegend": true
      },
      "pieType": {{ pie_chart_type | jsonify }},
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ],
        "fields": "",
        "values": false
      },
      "tooltip": {
        "mode": "single",
        "sort": "none"
      }
    },
    "targets": {{targets | jsonify}},
    "title": {{title | jsonify}},
    "transparent": false,
    "type": "piechart",
    "transformations": {{transformations | jsonify}}
  }
