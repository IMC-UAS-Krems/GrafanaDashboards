{
    "datasource": {
      "type": "marcusolsson-json-datasource",
      "uid": {{ datasource_uid | jsonify }}
    },
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "thresholds"
        },
        "custom": {
          "hideFrom": {
            "legend": false,
            "tooltip": false,
            "viz": false
          }
        },
        "fieldMinMax": true,
        "mappings": [],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "red",
              "value": 80
            }
          ]
        }
      },
      "overrides": []
    },
    "gridPos": {{ grid_pos | jsonify }},
    "id": {{ id | jsonify }},
    "options": {
      "basemap": {
        "config": {},
        "name": "Layer 0",
        "type": "default"
      },
      "controls": {
        "mouseWheelZoom": true,
        "showAttribution": true,
        "showDebug": false,
        "showMeasure": false,
        "showScale": false,
        "showZoom": true
      },
      "layers": [
        {
          "config": {
            "showLegend": true,
            "style": {
              "color": {
                "fixed": "dark-green"
              },
              "opacity": 0.4,
              "rotation": {
                "fixed": 0,
                "max": 360,
                "min": -360,
                "mode": "mod"
              },
              "size": {
                "fixed": 5,
                "max": 15,
                "min": 2
              },
              "symbol": {
                "fixed": "img/icons/marker/circle.svg",
                "mode": "fixed"
              },
              "symbolAlign": {
                "horizontal": "center",
                "vertical": "center"
              },
              "textConfig": {
                "fontSize": 12,
                "offsetX": 0,
                "offsetY": 0,
                "textAlign": "center",
                "textBaseline": "middle"
              }
            }
          },
          "location": {
            "mode": "auto"
          },
          "name": "Layer 1",
          "tooltip": true,
          "type": "markers"
        }
      ],
      "tooltip": {
        "mode": "details"
      },
      "view": {
        "allLayers": true,
        "id": "fit",
        "lat": 0,
        "lon": 0,
        "padding": 50,
        "zoom": 15
      }
    },
    "pluginVersion": "10.2.2",
    "targets": {{targets | jsonify}},
    "title": {{title | jsonify}},
    "transformations": {{transformations | jsonify}},
    "type": "geomap"
  }
