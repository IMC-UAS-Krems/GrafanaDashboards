  {
    "datasource": {
      "type": "marcusolsson-json-datasource",
      "uid": {{ datasource_uid | jsonify }}
    },
    "fieldConfig": {
      "defaults": {
        "color": {
          "fixedColor": "green",
          "mode": "fixed"
        },
        "custom": {
          "axisBorderShow": false,
          "axisCenteredZero": false,
          "axisColorMode": "text",
          "axisLabel": "",
          "axisPlacement": "auto",
          "hideFrom": {
            "legend": false,
            "tooltip": false,
            "viz": false
          },
          "pointSize": {
            "fixed": 9
          },
          "scaleDistribution": {
            "type": "linear"
          },
          "show": "points"
        },
        "mappings": [
          {
            "options": {
              "Luftfeuchtigkeit": {
                "color": "orange",
                "index": 1
              },
              "Temperatur": {
                "color": "yellow",
                "index": 0
              }
            },
            "type": "value"
          }
        ],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            }
          ]
        }
      },
      "overrides": [
        {
          "__systemRef": "hideSeriesFrom",
          "matcher": {
            "id": "byNames",
            "options": {
              "mode": "exclude",
              "names": [
                "Feinstaub"
              ],
              "prefix": "All except:",
              "readOnly": true
            }
          },
          "properties": [
            {
              "id": "custom.hideFrom",
              "value": {
                "legend": false,
                "tooltip": false,
                "viz": true
              }
            }
          ]
        }
      ]
    },
    "gridPos": {{ grid_pos | jsonify }},
    "id": {{id | jsonify }},
    "options": {
      "dims": {},
      "legend": {
        "calcs": [],
        "displayMode": "list",
        "placement": "bottom",
        "showLegend": true
      },
      "series": [
        {
          "pointColor": {}
        }
      ],
      "seriesMapping": "auto",
      "tooltip": {
        "mode": "single",
        "sort": "none"
      }
    },
    "pluginVersion": "10.2.2",
    "targets": {{targets | jsonify}},
    "title": {{title | jsonify}},
    "transformations": {{transformations | jsonify}},
    "type": "xychart"
  }